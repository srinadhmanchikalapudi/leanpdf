{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeanPDF",
  "version": "0.1.0",
  "identifier": "app.leanpdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeanPDF",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
